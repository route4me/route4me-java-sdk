<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Checkstyle 9.3 rules of the Route4Me Java SDK: the library (src/main/java), the tests
    (src/test/java) and the examples (src/examples/java).

    Based on the Sun checks that ship with Checkstyle (sun_checks.xml), with 4-space
    indentation and 120 columns. Every violation is a warning, and the build fails on any
    warning (maven-checkstyle-plugin: failOnViolation, violationSeverity=warning).

    Sun checks left out, and why:
    - MagicNumber: the examples and the tests are made of literal data (coordinates, epoch
      times, durations, IDs, HTTP statuses). A constant per literal would make them harder
      to read, not safer.
    - FinalParameters: a style choice, not a defect check; it would put `final` on about
      1,200 parameters and catches nothing that a review of a reassigned parameter does not.
    - DesignForExtension: the managers are meant to be subclassed (the tests do, and so may
      users), and the models are Lombok classes; making their public methods final would
      break the API.
    - HideUtilityClassConstructor: QueryConverter, DateTimeUtils and ServiceTimeUtils are
      published with a public constructor, which the rule would remove (an API break).
    - HiddenField is kept, but ignores constructor and setter parameters, the standard
      `this.name = name` idiom.
    - Translation and Header: the project has no resource bundles and no license header.

    Targeted exceptions use @SuppressWarnings("checkstyle:<check>") with a comment, on the
    few members whose names or visibility are public API (mostly Lombok fields, whose name is
    the name of the generated getter and setter).
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <!-- The tests may skip the Javadoc rules, and only those (see suppressions.xml). -->
  <module name="SuppressionFilter">
    <property name="file" value="${config_loc}/suppressions.xml"/>
    <property name="optional" value="false"/>
  </module>
  <module name="SuppressWarningsFilter"/>

  <module name="JavadocPackage"/>
  <module name="NewlineAtEndOfFile"/>
  <module name="FileLength"/>
  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="ignorePattern" value="^(package|import) |https?://"/>
  </module>
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>
  <module name="RegexpSingleline">
    <property name="format" value="\s+$"/>
    <property name="minimum" value="0"/>
    <property name="maximum" value="0"/>
    <property name="message" value="Line has trailing spaces."/>
  </module>

  <module name="TreeWalker">
    <module name="SuppressWarningsHolder"/>

    <!-- Javadoc -->
    <module name="InvalidJavadocPosition"/>
    <module name="JavadocMethod">
      <property name="accessModifiers" value="public"/>
    </module>
    <module name="JavadocType"/>
    <module name="JavadocVariable">
      <property name="scope" value="public"/>
    </module>
    <module name="JavadocStyle"/>
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
      <property name="allowMissingPropertyJavadoc" value="false"/>
      <property name="ignoreMethodNamesRegex" value="^main$"/>
    </module>

    <!-- Naming -->
    <module name="ConstantName"/>
    <module name="LocalFinalVariableName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="MethodName"/>
    <module name="PackageName"/>
    <module name="ParameterName"/>
    <module name="StaticVariableName"/>
    <module name="TypeName"/>

    <!-- Imports -->
    <module name="AvoidStarImport"/>
    <module name="IllegalImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>

    <!-- Size -->
    <module name="MethodLength"/>
    <module name="ParameterNumber"/>

    <!-- Whitespace and layout -->
    <module name="Indentation">
      <property name="basicOffset" value="4"/>
      <property name="caseIndent" value="4"/>
      <property name="lineWrappingIndentation" value="4"/>
    </module>
    <module name="EmptyForIteratorPad"/>
    <module name="GenericWhitespace"/>
    <module name="MethodParamPad"/>
    <module name="NoWhitespaceAfter"/>
    <module name="NoWhitespaceBefore"/>
    <module name="OperatorWrap"/>
    <module name="ParenPad"/>
    <module name="TypecastParenPad"/>
    <module name="WhitespaceAfter"/>
    <module name="WhitespaceAround"/>

    <!-- Modifiers -->
    <module name="ModifierOrder"/>
    <module name="RedundantModifier"/>

    <!-- Blocks -->
    <module name="AvoidNestedBlocks"/>
    <module name="EmptyBlock">
      <property name="option" value="TEXT"/>
    </module>
    <module name="LeftCurly"/>
    <module name="NeedBraces"/>
    <module name="RightCurly"/>

    <!-- Coding -->
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="HiddenField">
      <property name="ignoreConstructorParameter" value="true"/>
      <property name="ignoreSetter" value="true"/>
      <property name="setterCanReturnItsClass" value="true"/>
    </module>
    <module name="IllegalInstantiation"/>
    <module name="InnerAssignment"/>
    <module name="MissingSwitchDefault"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <!-- Class design -->
    <module name="FinalClass"/>
    <module name="InterfaceIsType"/>
    <module name="VisibilityModifier"/>

    <!-- Miscellaneous -->
    <module name="ArrayTypeStyle"/>
    <module name="TodoComment"/>
    <module name="UpperEll"/>
  </module>
</module>
