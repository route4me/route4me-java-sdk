<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN" "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!--
      The unit tests need no Javadoc: their names say what they check, and they are not
      published. Only the Javadoc checks are relaxed for them; every other rule applies.
  -->
  <suppress files="[\\/]src[\\/]test[\\/]java[\\/]"
            checks="JavadocPackage|JavadocMethod|JavadocType|JavadocVariable|JavadocStyle|MissingJavadocType|MissingJavadocMethod|InvalidJavadocPosition"/>
  <!-- TEMPORARY: removed by the commit that completes the Javadoc of the library and the examples. -->
  <suppress files="[\\/]src[\\/](main|examples)[\\/]java[\\/]"
            checks="JavadocPackage|JavadocVariable|MissingJavadocType|MissingJavadocMethod|InvalidJavadocPosition"/>
</suppressions>
